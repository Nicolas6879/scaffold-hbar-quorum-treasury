# Copy to .env.local (gitignored) and fill in. Never commit real keys.

# Network the scripts target (testnet only by default)
HEDERA_NETWORK=testnet

# One funded testnet account pays for setup. Create it free at https://portal.hedera.com
OPERATOR_ID=
# ECDSA hex or DER private key. For a raw ED25519 hex key also set OPERATOR_KEY_TYPE=ED25519
OPERATOR_KEY=

# Optional: your HashPack account's PUBLIC key, to be signer 1 and sign in the browser.
# Signers 2 and 3 (and signer 1 if this is empty) are generated by `yarn treasury:setup` and stored here as SIGNER{n}_KEY.
SIGNER1_PUBLIC_KEY=

# Optional: Reown/WalletConnect project id (free at https://cloud.reown.com) for HashPack signing in the UI
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# Optional: point the dashboard at a different treasury
NEXT_PUBLIC_TREASURY_ID=
